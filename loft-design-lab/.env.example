# Server Port
PORT=3000

# Telegram Bot Token (создается через @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Telegram Chat ID or Group ID for receiving orders (e.g. 279223241 or comma-separated: 279223241,-100123456789)
TELEGRAM_CHAT_ID=279223241

# AI Assistant LLM Provider (Google Gemini or OpenAI)
# Gemini API Key: get free from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API Key (optional alternative): get from https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

